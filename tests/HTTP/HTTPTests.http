# HTTP tests.

# In order to run the tests at the bottom directly in vscode, install extension "Rest Client" by Huachao Mao.

# CLI run

# cURL - exception handler 1: "No View renderer available for any of the accept mime types."
curl --header "Accept: custom/mime-no-exist" -w "\n" --verbose https://sandbox.ddev.site

# cURL - exception handler 2: DomainException 'Not implemented.'
curl --header "Accept: text/html" -w "\n" --verbose https://sandbox.ddev.site/sandbox/qwerty
curl --header "Accept: application/json" -w "\n" --verbose https://sandbox.ddev.site/sandbox/qwerty

# cURL - 404
curl --header "Accept: */*" -w "\n" --verbose https://sandbox.ddev.site/noexist/foo/bar
curl --header "Accept: application/json" -w "\n" --verbose https://sandbox.ddev.site/noexist/foo/bar

# cURL - Homepage
curl --header "Accept: */*" -w "\n" --verbose https://sandbox.ddev.site/
curl --header "Accept: application/json" -w "\n" --verbose https://sandbox.ddev.site/

# cURL - Sandbox test
curl --header "Accept: text/html" -w "\n" --verbose "https://sandbox.ddev.site/sandbox/test/<script>alert('xss')</script>"
curl --header "Accept: application/json" -w "\n" --verbose https://sandbox.ddev.site/sandbox/test
curl --header "Accept: application/json" -w "\n" --verbose https://sandbox.ddev.site/sandbox/test/foo
curl --header "Accept: application/json" -w "\n" --verbose https://sandbox.ddev.site/sandbox/qwerty
curl --header "Accept: */*" -w "\n" --verbose https://sandbox.ddev.site/sandbox/test/foo

# cURL - language: `?lang=` (sets the `lang` cookie), then the cookie, then Accept-Language, then English
curl --header "Accept: text/html" -w "\n" --verbose "https://sandbox.ddev.site/sandbox/test?lang=de"
curl --header "Accept: text/html" --header "Cookie: lang=de" -w "\n" --verbose https://sandbox.ddev.site/sandbox/test
curl --header "Accept: text/html" --header "Accept-Language: de-AT,en;q=0.5" -w "\n" --verbose https://sandbox.ddev.site/sandbox/test
# Unknown language: ignored, the next source decides
curl --header "Accept: text/html" -w "\n" --verbose "https://sandbox.ddev.site/sandbox/test?lang=fr"

# cURL  - API test
# OK
curl --header "Accept: application/json" -w "\n" --verbose https://sandbox.ddev.site/api/v1/version
# Error "Please use the appropriate "Accept" headers in order to use the API."
curl --header "Accept: text/html" -w "\n" --verbose https://sandbox.ddev.site/api/v1/version
# OK
curl --header "Accept: */*" -w "\n" --verbose https://sandbox.ddev.site/api/v1/version

# cURL - CSRF: a POST without a session or a token gets the error page (403, "This page has expired."), in every module
# except api
curl --silent --dump-header - --data "a=b" https://sandbox.ddev.site/sandbox/test | grep -E '^HTTP|Code:|Message:'
# The api module isn't checked: its own error (no JWT)
curl --silent --header "Accept: application/vnd.api+json" --data "a=b" -w "\n" https://sandbox.ddev.site/api/v1/version

# cURL - Stuff: session, CSRF token, flash messages. Set P to AUTHENTICATION_PASSWORD (config/.env.ini) first.
# The login form's token; the login without it (403) and with a wrong one (403); with it: 303 and a new session ID
# (Set-Cookie); the next page shows "You are logged in." once (then 0), and has the new token. Logout: a GET only
# redirects to the items (no Set-Cookie); a POST without the token gets 403; with it: 303 and a new session that holds
# only the message; the login form shows "You are logged out." (in German after ?lang=de)
J=$(mktemp); curl --silent --output /dev/null --cookie-jar "$J" https://sandbox.ddev.site/stuff/item; \
  T=$(curl --silent --cookie "$J" https://sandbox.ddev.site/stuff/authenticate | grep -o -E 'name="csrf_token" value="[0-9a-f]{64}"' | grep -o -E '[0-9a-f]{64}'); \
  curl --silent --cookie "$J" --data-urlencode "password=$P" --output /dev/null --write-out "%{http_code}\n" https://sandbox.ddev.site/stuff/authenticate; \
  curl --silent --cookie "$J" --data-urlencode "password=$P" --data "csrf_token=${T}0" --output /dev/null --write-out "%{http_code}\n" https://sandbox.ddev.site/stuff/authenticate; \
  curl --silent --cookie "$J" --cookie-jar "$J" --data-urlencode "password=$P" --data "csrf_token=$T" --output /dev/null --dump-header - https://sandbox.ddev.site/stuff/authenticate | grep -i -E '^(HTTP|location|set-cookie)'; \
  curl --silent --cookie "$J" https://sandbox.ddev.site/stuff/item | grep -A1 '<article role="status"'; \
  curl --silent --cookie "$J" https://sandbox.ddev.site/stuff/item | grep -c '<article role="status"'; \
  T=$(curl --silent --cookie "$J" https://sandbox.ddev.site/stuff/item | grep -o -E 'name="csrf_token" value="[0-9a-f]{64}"' | head -1 | grep -o -E '[0-9a-f]{64}'); \
  curl --silent --cookie "$J" --output /dev/null --dump-header - https://sandbox.ddev.site/stuff/logout | grep -i -E '^(HTTP|location|set-cookie)'; \
  curl --silent --cookie "$J" --data "a=b" --output /dev/null --write-out "%{http_code}\n" https://sandbox.ddev.site/stuff/logout; \
  curl --silent --cookie "$J" --cookie-jar "$J" --data "csrf_token=$T" --output /dev/null --dump-header - "https://sandbox.ddev.site/stuff/logout?lang=de" | grep -i -E '^(HTTP|location|set-cookie)'; \
  curl --silent --cookie "$J" https://sandbox.ddev.site/stuff/authenticate | grep -A1 '<article role="status"'; \
  rm "$J"

# cURL - Stuff: deleting an item. Needs the `stuff_item` table, which this repository doesn't create. Set P first.
# Login; a new item (303 to its list); the item page links to the confirmation page; the confirmation page (its
# question and form); a POST without the token (403); with it: 303 to the list the item was in, then "Item deleted: …"
J=$(mktemp); curl --silent --output /dev/null --cookie-jar "$J" https://sandbox.ddev.site/stuff/item; \
  T=$(curl --silent --cookie "$J" https://sandbox.ddev.site/stuff/authenticate | grep -o -E 'name="csrf_token" value="[0-9a-f]{64}"' | grep -o -E '[0-9a-f]{64}'); \
  curl --silent --cookie "$J" --cookie-jar "$J" --data-urlencode "password=$P" --data "csrf_token=$T" --output /dev/null https://sandbox.ddev.site/stuff/authenticate; \
  T=$(curl --silent --cookie "$J" https://sandbox.ddev.site/stuff/item | grep -o -E 'name="csrf_token" value="[0-9a-f]{64}"' | head -1 | grep -o -E '[0-9a-f]{64}'); \
  I=$(curl --silent --cookie "$J" --data "csrf_token=$T&name=Test+item&description=Test" --output /dev/null --write-out "%{redirect_url}" https://sandbox.ddev.site/stuff/item | grep -o -E '[0-9]+$'); echo "item $I"; \
  curl --silent --cookie "$J" https://sandbox.ddev.site/stuff/item/$I | grep 'item-delete'; \
  curl --silent --cookie "$J" https://sandbox.ddev.site/stuff/item-delete/$I | grep -E 'Delete \[|action=|<button'; \
  curl --silent --cookie "$J" --data "a=b" --output /dev/null --write-out "%{http_code}\n" https://sandbox.ddev.site/stuff/item-delete/$I; \
  curl --silent --cookie "$J" --data "csrf_token=$T" --output /dev/null --dump-header - https://sandbox.ddev.site/stuff/item-delete/$I | grep -i -E '^(HTTP|location)'; \
  curl --silent --cookie "$J" https://sandbox.ddev.site/stuff/items | grep -A1 '<article role="status"'; \
  rm "$J"

